# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public address of the server, without a port (the port is appended outside production)
DOMAIN=http://127.0.0.1
PORT=8080

# auto - detect the version by domain (apps/web/config/sites.js), poland - force the Polish version, global - force the global version
SITE_MODE=auto

# Origins allowed to frame /embed (comma separated, default https://meshcoreprofiles.com)
EMBED_PARENTS=

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
MONGODB_URL=

REDIS_HOST=
REDIS_PASSWD=

# ---------------------------------------------------------------------------
# Elevation API (terrain and coverage tools)
# ---------------------------------------------------------------------------
SEFINEK_API=http://127.0.0.1:4010

# ---------------------------------------------------------------------------
# Base maps - each key unlocks the maps of that provider; without it they are hidden. The default map (OpenFreeMap) needs no key.
# Check each provider's terms for your use: MapTiler's free plan is non-commercial only, CARTO's free tier has a monthly quota, Esri forbids storing its data.
# A key restricted to the site's domains is refused on localhost: use a separate key for development.
# ---------------------------------------------------------------------------
# Esri ArcGIS Location Platform (location.arcgis.com)
ESRI_API_KEY=
# MapTiler (cloud.maptiler.com/account/keys)
MAPTILER_API_KEY=
# CARTO Basemaps (carto.com/basemaps/apikey)
CARTO_API_KEY=

# Keys handed to the mobile app by /api/v1/app-config (create them for the app, without a referrer restriction). There is no fallback to the keys above,
# and no Esri key: its terms forbid storing the map data, which the app's tile cache does.
MAPTILER_API_KEY_MOBILE=
CARTO_API_KEY_MOBILE=

# ---------------------------------------------------------------------------
# Bugsnag error reporting of the mobile app (project type Expo / React Native) - handed to the app by /api/v1/app-config; the app reports errors only when it is set
# ---------------------------------------------------------------------------
BUGSNAG_API_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile - node deletion is disabled without these (allow both map hostnames in the widget settings)
# The values below are Cloudflare's always-passing test keys
# ---------------------------------------------------------------------------
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
