NODE_ENV=development
DOMAIN=http://127.0.0.1
PORT=8080

SEFINEK_API=http://127.0.0.1:4010

# auto - detect version by domain (config/sites.js), poland - force the Polish version, global - force the global version
SITE_MODE=auto

# MongoDB
MONGODB_URL=

# Shared secret expected in the X-Internal-Secret header of POST /api/internal/stats-snapshot,
# called once a day by the meshcore-profiles/cronjobs worker (must match its own copy of this value)
STATS_SNAPSHOT_SECRET=

# Redis
REDIS_HOST=
REDIS_PASSWD=

# MapTiler API key (cloud.maptiler.com/account/keys)
MAPTILER_API_KEY=

# CARTO Basemaps API key (carto.com/basemaps/apikey)
CARTO_API_KEY=
