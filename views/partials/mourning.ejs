<dialog id="mourning-notice" aria-labelledby="mourning-title" aria-describedby="mourning-description">
	<p class="mourning-date"><%= t('mourning:date') %></p>
	<h2 id="mourning-title"><%= t('mourning:title') %></h2>
	<p id="mourning-description"><%= t('mourning:description') %></p>
	<form method="dialog">
		<button class="btn" autofocus><%= t('mourning:close') %></button>
	</form>
</dialog>
