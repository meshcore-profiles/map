<!DOCTYPE html>
<% const _switchUrl = code => {
	const base = langPath(code, '/');
	const qs = locals.currentQuery ? `${locals.currentQuery}&setlang=${code}` : `setlang=${code}`;
	return `${base}${base.includes('?') ? '&' : '?'}${qs}`;
};
const _curMeta = languages.find(l => l.code === languageCode) || languages[0];
const _titleBrand = site.shortName || site.brandName; %>
<html lang="<%= _curMeta.htmlLang %>" data-theme="<%= site.theme %>">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= t('meta:title', { brand: _titleBrand }) %></title>

	<!-- Primary meta -->
	<meta name="description" content="<%= t('meta:description') %>">
	<meta name="keywords" content="<%= t('meta:keywords') %>">
	<link rel="canonical" href="<%= domain + lp('/') %>">
	<% languages.forEach(l => { %><link rel="alternate" hreflang="<%= l.code %>" href="<%= domain + langPath(l.code, '/') %>">
	<% }); %><link rel="alternate" hreflang="x-default" href="<%= domain + langPath(defaultLanguage, '/') %>">
	<meta name="theme-color" content="<%= site.themeColor %>">

	<!-- Open Graph -->
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="<%= site.brandName %>">
	<meta property="og:locale" content="<%= _curMeta.ogLocale %>">
	<% languages.forEach(l => { if (l.code !== languageCode) { %><meta property="og:locale:alternate" content="<%= l.ogLocale %>"><% } }); %>
	<meta property="og:title" content="<%= t('meta:title', { brand: _titleBrand }) %>">
	<meta property="og:description" content="<%= t('meta:description') %>">
	<meta property="og:url" content="<%= domain + lp('/') %>">
	<meta property="og:image" content="<%= site.ogImage %>">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="675">
	<meta property="og:image:alt" content="<%= t('meta:ogImageAlt', { brand: site.brandName }) %>">

	<!-- Twitter / X Card -->
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="<%= t('meta:title', { brand: _titleBrand }) %>">
	<meta name="twitter:description" content="<%= t('meta:description') %>">
	<meta name="twitter:image" content="<%= site.ogImage %>">
	<meta name="twitter:image:alt" content="<%= t('meta:ogImageAlt', { brand: site.brandName }) %>">

	<!-- JavaScript -->
	<script src="https://cdn.sefinek.net/js/progressbar.js" defer></script>

	<!-- Icons & manifest -->
	<link rel="icon" href="<%= site.favicon %>" sizes="16x16 32x32 48x48 64x64 128x128 256x256">
	<% if (site.faviconSvg) { %><link rel="icon" href="<%= site.faviconSvg %>" type="image/svg+xml"><% } %>
	<link rel="icon" href="<%= site.icon192 %>" type="image/png" sizes="192x192">
	<link rel="apple-touch-icon" href="<%= site.appleIcon %>" sizes="180x180">
	<link rel="manifest" href="/manifest.json">

	<!-- Stylesheets -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preconnect" href="https://cdn.sefinek.net">
	<link rel="preconnect" href="https://cdn.sefinek.net" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,800&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet">
	<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
	<link rel="stylesheet" href="/vendor/markercluster/MarkerCluster.css">
	<link rel="stylesheet" href="/vendor/markercluster/MarkerCluster.Default.css">
	<link rel="stylesheet" href="/css/global.css">
	<link rel="stylesheet" href="/css/themes/<%= site.theme %>.css">
	<link rel="stylesheet" href="/css/legend.css">
	<link rel="stylesheet" href="/css/modal.css">
	<link rel="stylesheet" href="/css/stats.css">
	<link rel="stylesheet" href="/css/toast.css">
	<link rel="stylesheet" href="/css/tools.css">

	<!-- schema.org -->
	<script type="application/ld+json">
	<%- JSON.stringify({
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'Organization',
				'@id': `${site.brandUrl}#organization`,
				name: site.brandName,
				url: site.brandUrl,
				sameAs: ['https://github.com/meshcore-profiles', site.discordUrl],
			},
			{
				'@type': 'WebApplication',
				'@id': `${domain}/#webapp`,
				name: t('meta:webAppName', { brand: _titleBrand }),
				description: t('meta:description'),
				url: domain + lp('/'),
				applicationCategory: 'UtilitiesApplication',
				operatingSystem: 'Any',
				isPartOf: { '@id': `${domain}/#website` },
			},
			{
				'@type': 'WebSite',
				'@id': `${domain}/#website`,
				name: t('meta:webAppName', { brand: _titleBrand }),
				url: domain + lp('/'),
				inLanguage: _curMeta.ogLocale.replace('_', '-'),
				publisher: { '@id': `${site.brandUrl}#organization` },
			},
			{
				'@type': 'BreadcrumbList',
				itemListElement: [
					{ '@type': 'ListItem', position: 1, name: t('meta:webAppName', { brand: _titleBrand }), item: domain + lp('/') },
				],
			},
		],
	}) %>
	</script>
</head>
<body>
<h1 class="sr-only"><%= t('meta:heading', { brand: _titleBrand }) %></h1>
<main id="map"></main>
<div id="loading-overlay" role="status" aria-live="polite" aria-label="<%= t('map:loadingAriaLabel') %>" hidden>
	<div id="loading-card">
		<div id="spinner"></div>
		<div id="loading-status"></div>
		<div id="loading-progress"><div id="loading-progress-bar"></div></div>
		<div id="loading-meta"></div>
		<button type="button" id="loading-cancel-btn"><%= t('common:cancel') %></button>
	</div>
</div>

<header id="stats-bar">
	<a id="brand" href="<%= site.brandUrl %>" target="_blank" rel="noopener" title="<%= site.brandName %>">
		<% if (site.logo) { %><img src="<%= site.logo %>" alt="" width="34" height="34"><% } %>
		<span id="brand-name"><%- site.brandNameHtml %></span>
	</a>
	<span id="stats-divider"></span>
	<span id="stats-counts"></span>
	<button type="button" class="region-toggle-btn" id="stats-toggle" title="<%= t('stats:toggleTitle') %>" aria-label="<%= t('stats:toggleTitle') %>">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#chart"></use></svg>
	</button>

	<span class="spacer" id="spacer-1"></span>
	<form id="search-form">
		<svg class="icon" id="search-icon" aria-hidden="true"><use href="/icons/icons.svg#search"></use></svg>
		<input type="text" class="text-input" id="search-input" placeholder="<%= t('map:searchPlaceholder') %>" autocomplete="off">
		<button type="button" id="filter-toggle" title="<%= t('filters:toggleTitle') %>" aria-label="<%= t('filters:toggleTitle') %>">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#filter"></use></svg>
			<span id="filter-active-dot" hidden></span>
		</button>
	</form>

	<span class="spacer" id="spacer-2"></span>
	<% if (site.showRegionToggle) { %>
	<button type="button" class="region-toggle-btn" id="region-toggle" title="<%= t('map:showAllWorld') %>" aria-label="<%= t('map:showAllWorld') %>">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#globe"></use></svg>
		<span id="region-toggle-label"><%= t('map:polandOnlyLabel') %></span>
	</button>
	<% } %>
	<button type="button" class="region-toggle-btn" id="basemap-toggle" title="<%= t('map:basemapToggleTitle') %>" aria-label="<%= t('map:basemapToggleTitle') %>">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#layers"></use></svg>
		<span id="basemap-toggle-label"><%= t('map:changeMapLabel') %></span>
	</button>
	<% if (site.languageSwitcher === 'dropdown') { %>
	<select id="lang-select" class="region-toggle-btn lang-select" aria-label="<%= t('common:langLabel') %>">
		<% languages.forEach(l => { %><option value="<%= site.crossLinks?.[l.code] || _switchUrl(l.code) %>" <%= l.code === languageCode ? 'selected' : '' %>><%= l.name %></option><% }); %>
	</select>
	<% } %>
	<a href="https://github.com/meshcore-profiles/map" id="github-link" title="<%= t('common:githubRepoTitle') %>" aria-label="<%= t('common:githubRepoTitle') %>" target="_blank" rel="noopener">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#github"></use></svg>
	</a>
</header>

<menu id="node-filter" hidden>
	<li id="filters-row">
		<div class="filters-col" id="filters-col-main">
			<fieldset id="node-type-group">
				<legend><%= t('filters:nodeTypesLegend') %></legend>
				<label class="checkbox-label"><input type="checkbox" class="node-type-checkbox" value="1" checked> <%= t('filters:clients') %></label>
				<label class="checkbox-label"><input type="checkbox" class="node-type-checkbox" value="2" checked> <%= t('filters:repeaters') %></label>
				<label class="checkbox-label"><input type="checkbox" class="node-type-checkbox" value="3" checked> <%= t('filters:roomServers') %></label>
				<label class="checkbox-label"><input type="checkbox" class="node-type-checkbox" value="4" checked> <%= t('filters:sensors') %></label>
			</fieldset>
			<div class="field-group">
				<label for="from-date"><%= t('filters:lastUpdate') %></label>
				<input type="date" class="date-input" id="from-date">
			</div>
			<div class="field-group">
				<label for="from-insert-date"><%= t('filters:added') %></label>
				<input type="date" class="date-input" id="from-insert-date">
			</div>
			<div class="field-group">
				<label for="clustering-zoom"><%= t('filters:clusteringZoom') %></label>
				<input type="range" id="clustering-zoom" min="10" max="17" value="11">
			</div>
		</div>
		<div class="filters-col field-group" id="freq-filter-group" hidden>
			<span><%= t('filters:frequency') %></span>
			<div id="freq-filter-list"></div>
		</div>
	</li>
	<li class="filters-actions">
		<button type="button" class="apply-filters-btn" id="apply-filters-btn"><%= t('filters:apply') %></button>
		<button type="button" class="clear-filters-btn" id="clear-filters-btn" hidden><%= t('filters:clearFilters') %></button>
	</li>
</menu>

<ul id="search-results" hidden></ul>

<ul id="basemap-menu" hidden></ul>

<div id="fab-stack">
	<button type="button" class="fab fab-secondary" id="terrain-toggle" title="<%= t('terrain:toggleTitle') %>" aria-label="<%= t('terrain:toggleTitle') %>">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#terrain"></use></svg>
	</button>
	<button type="button" class="fab fab-secondary" id="coverage-toggle" title="<%= t('coverage:toggleTitle') %>" aria-label="<%= t('coverage:toggleTitle') %>">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#coverage"></use></svg>
	</button>
	<button type="button" class="fab fab-secondary" id="route-toggle" title="<%= t('route:toggleTitle') %>" aria-label="<%= t('route:toggleTitle') %>">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#route"></use></svg>
	</button>
	<button type="button" class="fab fab-secondary" id="measure-toggle" title="<%= t('measure:toggleTitle') %>" aria-label="<%= t('measure:toggleTitle') %>">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#ruler"></use></svg>
	</button>
	<button type="button" class="fab fab-secondary" id="settings-toggle" title="<%= t('settings:title') %>" aria-label="<%= t('settings:title') %>">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#settings"></use></svg>
	</button>
	<button type="button" class="fab fab-secondary" id="legend-toggle" title="<%= t('legend:toggleTitle') %>" aria-label="<%= t('legend:toggleTitle') %>">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#info"></use></svg>
	</button>
	<a class="fab" id="fab-primary" title="<%= t('map:addNodeTitle') %>" aria-label="<%= t('map:addNodeTitle') %>" target="_blank" rel="noopener" href="https://github.com/meshcore-dev/MeshCore/blob/main/docs/faq.md#512-q-how-do-i-add-a-node-to-the-meshcore-map">
		<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#plus"></use></svg>
	</a>
</div>

<div class="modal-overlay" id="region-warning-overlay" hidden>
	<div class="settings-panel" id="region-warning-panel" role="dialog" aria-modal="true" aria-labelledby="region-warning-title">
		<div class="modal-warning-header">
			<span class="modal-warning-icon"><svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#warning"></use></svg></span>
			<div class="modal-title" id="region-warning-title"><%= t('map:regionWarningTitle') %></div>
		</div>
		<p id="region-warning-text">
			<%- t('map:regionWarningText', { size: `<span id="region-warning-size">${t('map:unknownSize')}</span>` }) %>
		</p>
		<div id="region-warning-actions">
			<button type="button" class="region-warning-btn" id="region-warning-cancel"><%= t('common:cancel') %></button>
			<button type="button" class="region-warning-btn" id="region-warning-confirm"><%= t('map:downloadAnyway') %></button>
		</div>
	</div>
</div>

<div class="modal-overlay" id="contact-error-overlay" hidden>
	<div class="settings-panel" id="contact-error-panel" role="dialog" aria-modal="true" aria-labelledby="contact-error-title">
		<button type="button" class="modal-close-btn" id="contact-error-close-btn" aria-label="<%= t('common:close') %>">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<div class="modal-warning-header">
			<span class="modal-warning-icon"><svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#warning"></use></svg></span>
			<div class="modal-title" id="contact-error-title"><%= t('map:addContactErrorTitle') %></div>
		</div>
		<p id="contact-error-text"></p>
	</div>
</div>

<div class="modal-overlay" id="settings-overlay" hidden>
	<div class="settings-panel" id="settings-panel" role="dialog" aria-modal="true" aria-labelledby="settings-title">
		<button type="button" class="modal-close-btn" id="settings-close-btn" aria-label="<%= t('settings:closeAria') %>">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<div class="modal-title" id="settings-title"><%= t('settings:title') %></div>

		<div class="setting-item">
			<label class="checkbox-label"><input type="checkbox" id="setting-close-filters-on-apply" checked aria-describedby="setting-close-filters-desc"> <%= t('settings:closeFiltersLabel') %></label>
			<p class="setting-desc" id="setting-close-filters-desc"><%= t('settings:closeFiltersDesc') %></p>
		</div>

		<div class="setting-item" id="setting-item-select">
			<label for="setting-elevation-source" id="setting-label"><%= t('settings:elevationSourceLabel') %></label>
			<select class="date-input" id="setting-elevation-source" aria-describedby="setting-elevation-desc">
				<option value="sefinek" selected><%= t('settings:elevationSefinek') %></option>
				<option value="open-elevation"><%= t('settings:elevationOpenElevation') %></option>
				<option value="open-meteo"><%= t('settings:elevationOpenMeteo') %></option>
			</select>
			<p class="setting-desc" id="setting-elevation-desc"><%= t('settings:elevationDesc') %></p>
		</div>

	</div>
</div>

<div class="modal-overlay" id="stats-overlay" hidden>
	<div id="stats-panel" role="dialog" aria-modal="true" aria-labelledby="stats-title">
		<button type="button" class="modal-close-btn" id="stats-close-btn" aria-label="<%= t('stats:closeAria') %>">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<div class="modal-title" id="stats-title"><%= t('stats:title') %></div>
		<div id="stats-chips">
			<div class="stats-chip"><span class="stats-chip-label">24h</span><span class="stats-chip-value" id="stats-chip-24h">0</span></div>
			<div class="stats-chip"><span class="stats-chip-label">7d</span><span class="stats-chip-value" id="stats-chip-7d">0</span></div>
			<div class="stats-chip"><span class="stats-chip-label">30d</span><span class="stats-chip-value" id="stats-chip-30d">0</span></div>
		</div>
		<div id="stats-period-group" role="group" aria-label="<%= t('stats:timeRangeAria') %>">
			<button type="button" class="stats-period-btn active" data-period="24h">24h</button>
			<button type="button" class="stats-period-btn" data-period="7d">7d</button>
			<button type="button" class="stats-period-btn" data-period="30d">30d</button>
			<button type="button" class="stats-period-btn" data-period="custom"><%= t('stats:range') %></button>
		</div>
		<div id="stats-range-inputs" hidden>
			<input type="date" class="date-input" id="stats-range-from" aria-label="<%= t('stats:fromDateAria') %>">
			<span id="stats-range-sep">–</span>
			<input type="date" class="date-input" id="stats-range-to" aria-label="<%= t('stats:toDateAria') %>">
			<button type="button" id="stats-range-back-btn" aria-label="<%= t('stats:backToRangesAria') %>">
				<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
			</button>
		</div>
		<ul id="stats-repeater-list"></ul>
		<button type="button" class="btn btn-outline" id="stats-show-on-map-btn"><%= t('stats:showOnMap') %></button>
	</div>
</div>

<div class="modal-overlay" id="legend-overlay" hidden>
	<div class="settings-panel" id="legend-panel" role="dialog" aria-modal="true" aria-labelledby="legend-title">
		<button type="button" class="modal-close-btn" id="legend-close-btn" aria-label="<%= t('legend:closeAria') %>">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<section id="legend-plans" aria-labelledby="legend-plans-title">
			<div class="modal-title" id="legend-plans-title"><%= t('legend:plansTitle') %></div>
			<p><%- t('legend:plansIntro') %></p>
			<ul>
				<li><%= t('legend:plansBullet1') %></li>
				<li><%= t('legend:plansBullet2') %></li>
				<li><%= t('legend:plansBullet3') %></li>
			</ul>
			<p><%- t('legend:plansBeta') %></p>
		</section>

		<div id="legend-columns">
			<div class="legend-col">
				<div class="modal-title" id="legend-title"><%= t('legend:typeTitle') %></div>
				<div class="legend-row"><svg class="legend-icon legend-icon-plain" width="20" height="20"><use href="/icons/node-types.svg#client-plain"></use></svg><span><%= t('map:nodeTypes.client') %></span></div>
				<div class="legend-row"><svg class="legend-icon legend-icon-plain" width="20" height="20"><use href="/icons/node-types.svg#repeater-plain"></use></svg><span><%= t('map:nodeTypes.repeater') %></span></div>
				<div class="legend-row"><svg class="legend-icon legend-icon-plain" width="20" height="20"><use href="/icons/node-types.svg#room-server-plain"></use></svg><span><%= t('map:nodeTypes.roomServer') %></span></div>
				<div class="legend-row"><svg class="legend-icon legend-icon-plain" width="20" height="20"><use href="/icons/node-types.svg#sensor-plain"></use></svg><span><%= t('map:nodeTypes.sensor') %></span></div>
			</div>

			<div class="legend-col">
				<div class="modal-title"><%= t('legend:mapTitle') %></div>
				<div class="legend-row"><svg class="legend-icon update-recent" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span><%= t('map:updateStatus.recent') %></span></div>
				<div class="legend-row"><svg class="legend-icon update-stale" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span><%= t('map:updateStatus.stale') %></span></div>
				<div class="legend-row"><svg class="legend-icon update-old" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span><%= t('map:updateStatus.old') %></span></div>
				<div class="legend-row"><svg class="legend-icon update-extinct" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span><%= t('map:updateStatus.extinct') %></span></div>
				<div class="legend-row"><svg class="legend-icon" width="20" height="20"><use href="/icons/node-types.svg#client"></use></svg><span><%= t('map:updateStatus.none') %></span></div>
			</div>
		</div>

		<div id="legend-footer">
			<div id="legend-footer-meta">
				<div><%= t('legend:siteVersion') %><%= v %></div>
				<div><%= t('legend:dataUpdate') %><span id="legend-updated-at">-</span></div>
			</div>
			<button type="button" class="btn btn-outline" id="changelog-toggle"><%= t('legend:changelogButton') %></button>
		</div>
	</div>
</div>

<div class="modal-overlay" id="changelog-overlay" hidden>
	<div class="settings-panel" id="changelog-panel" role="dialog" aria-modal="true" aria-label="<%= t('legend:changelogButton') %>">
		<button type="button" class="modal-close-btn" id="changelog-close-btn" aria-label="<%= t('legend:changelogButton') %>">
			<svg class="icon" aria-hidden="true"><use href="/icons/icons.svg#close"></use></svg>
		</button>
		<ul id="changelog-list"></ul>
