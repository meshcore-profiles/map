{
  "name": "meshcore-map",
  "version": "0.13.0",
  "private": true,
  "homepage": "https://map.meshcoreprofiles.com",
  "bugs": {
    "url": "https://github.com/meshcore-profiles/map/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meshcore-profiles/map.git"
  },
  "license": "MIT",
  "author": "Sefinek <contact@sefinek.net> (https://sefinek.net)",
  "main": "apps/web/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "badges": "npm run badges -w apps/mobile",
    "icons": "npm run icons -w apps/mobile",
    "lint": "eslint .",
    "m": "ncu -u --workspaces --root && npm install && npm update",
    "mobile": "npm start -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile",
    "mobile:check": "npm exec -w apps/mobile -- expo install --check",
    "mobile:export": "npm exec -w apps/mobile -- expo export --platform android",
    "mobile:ios": "npm run ios -w apps/mobile",
    "pull": "git pull origin main && git submodule update --init",
    "start": "npm start -w apps/web",
    "test": "npm test -w packages/core",
    "update": "npm run pull && npm ci --omit=dev -w apps/web && pm2 restart mcmap"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.7": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
