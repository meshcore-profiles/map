{
  "expo": {
    "name": "MeshCore Map",
    "slug": "meshcore-map",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "@maplibre/maplibre-react-native"
    ],
    "ios": {
      "bundleIdentifier": "com.sefinek.meshcoremap"
    },
    "android": {
      "package": "com.sefinek.meshcoremap",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "map.meshcoreprofiles.com"
            },
            {
              "scheme": "https",
              "host": "mapa.meshcorepolska.org"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "apiBase": "https://map.meshcoreprofiles.com",
      "sefinekApi": "https://api.sefinek.net",
      "androidCertSha1": "0B:E4:AA:8F:28:59:DD:D9:74:08:A1:F1:1C:03:2E:7E:59:EE:6E:E6",
      "androidCertSha256": "10:51:EA:B7:DA:66:04:2A:17:78:56:D4:A5:54:74:63:82:E4:44:D7:2C:C4:8C:03:2D:1B:A1:34:D5:A8:F3:79"
    },
    "scheme": "meshcoremap"
  }
}
