<!DOCTYPE html>
<% const title = t([`error:http.${status}.title`, 'error:http.default.title']); -%>
<html lang="<%= languages.find(l => l.code === languageCode)?.htmlLang || languageCode %>" data-theme="<%= site.theme %>">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex">
	<meta name="theme-color" content="<%= site.themeColor %>">
	<title><%= title %> - <%= site.shortName || site.brandName %></title>
	<link rel="icon" href="<%= site.favicon %>">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,800&amp;display=swap" rel="stylesheet">
	<link rel="stylesheet" href="/css/global.css">
	<link rel="stylesheet" href="/css/themes/<%= site.theme %>.css">
	<link rel="stylesheet" href="/css/error.css">
</head>
<body>
	<main id="error">
		<p id="error__code"><%= status %></p>
		<h1><%= title %></h1>
		<p><%= t([`error:http.${status}.message`, 'error:http.default.message']) %></p>
		<a href="<%= lp('/') %>" class="btn btn-outline"><%= t('error:backToMap') %></a>
	</main>
</body>
</html>
